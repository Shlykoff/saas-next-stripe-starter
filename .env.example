# Copy this file to .env.local and fill in real values. .env.local is
# gitignored -- never commit real keys (CLAUDE.md non-negotiable #1).

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Local dev: run `supabase start`, then copy URL/keys from `supabase status`.
# Production: the hosted Supabase project's own URL/keys (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# service_role key -- bypasses Row Level Security entirely. Server-only.
# NEVER prefix this with NEXT_PUBLIC_, never reference it from a Client
# Component or anything that ends up in the browser bundle
# (CLAUDE.md non-negotiable #2). Only lib/supabase/service-role.ts (used by
# the Stripe webhook handler) reads this.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ---------------------------------------------------------------------------
# Google OAuth (single OAuth provider per docs/spec.md)
# ---------------------------------------------------------------------------
# Real values come from a Google Cloud OAuth 2.0 Client (Google Cloud
# Console > APIs & Services > Credentials > "Create Credentials" > "OAuth
# client ID", application type "Web application"). Authorized redirect URI
# for local dev: http://127.0.0.1:54321/auth/v1/callback (Supabase Auth's
# own callback -- NOT this app's /auth/callback route, which is one hop
# further downstream). This repo cannot supply real values; see README
# "Google OAuth" for the full manual setup.
#
# IMPORTANT: unlike the other variables in this file, these are read by the
# `supabase start` process itself via config.toml's `env(...)` substitution
# (see [auth.external.google]), NOT by `npm run dev` / Next.js -- they must
# be exported into the shell environment BEFORE running `supabase start`
# (e.g. `export $(grep -v '^#' .env.local | xargs)`, or your shell profile /
# direnv), not just present in this file.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Test mode secret key, from https://dashboard.stripe.com/test/apikeys.
# In production this is the LIVE secret key from a separate .env on Vercel --
# test and live are two entirely separate key sets, never mixed
# (CLAUDE.md non-negotiable: "Разделение test/live режимов через переменные окружения").
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the webhook endpoint. For local dev this comes from
# `stripe listen` (see README "Testing Stripe webhooks locally"); in
# production it's the signing secret Stripe shows when you register the
# endpoint URL in the Dashboard (Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe Price ids for the plans on the pricing page (Products > a Price's
# id, starts with `price_`). Create these once in the Stripe Dashboard
# (test mode) -- this repo only references their ids, it doesn't create them.
STRIPE_PRICE_ID_BASIC=price_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me

# Billing portal configuration id (Developers > Billing > Customer portal, or
# create one via the API) with "Update subscription" enabled and both plans
# above listed as switchable products. Stripe's default portal configuration
# has plan-switching OFF -- without this, "Manage billing" only lets a
# customer cancel or update their payment method, not switch plans.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me

# ---------------------------------------------------------------------------
# Resend (organization-invite emails)
# ---------------------------------------------------------------------------
# Used directly by this Next.js app (lib/resend.ts) for transactional email
# that is NOT a Supabase Auth event -- currently just organization invites
# (app/actions/invites.ts sends these itself via the `resend` package,
# separately from Supabase Auth's own confirmation/recovery emails). This is
# the SAME API key already configured as the password in Supabase's Custom
# SMTP settings (Supabase Dashboard > Authentication > Emails > SMTP
# Settings) for those auth emails -- get/create it at Resend Dashboard >
# API Keys (https://resend.com/api-keys). The sender address
# (noreply@mail.shlykoff.com, hardcoded in lib/resend.ts) uses the same
# domain already verified in Resend for that Custom SMTP sender.
RESEND_API_KEY=re_replace_me

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Base URL used to build Stripe Checkout/Portal redirect URLs
# (success_url/cancel_url/return_url). http://127.0.0.1:3000 for local dev;
# the real deployed URL in production.
#
# IMPORTANT: this must match the host you actually type into the browser --
# "localhost" and "127.0.0.1" are different hosts as far as cookies are
# concerned, even though they point at the same server. If you sign in on
# http://127.0.0.1:3000 but this is set to http://localhost:3000, Stripe
# will redirect you back to a host that never received your session cookie
# post-Checkout, and you'll land on /dashboard looking logged out even
# though the payment succeeded. Pick one host and use it everywhere: this
# variable, the browser URL, and (for Google OAuth) supabase/config.toml's
# additional_redirect_urls.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
